# Dependencies and build output
node_modules/
dist/
src-tauri/target/
src-tauri/gen/

# Local tooling and OS files
.claude/*
# Project skills (how sessions build, run and test the app) are shared.
!.claude/skills/
.DS_Store
*.log

# Never commit company files or their backups
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.lock
*.QBB
*.qbb
*.QBW
*.qbw

# Third-party installers and tools dropped in for reference; never commit them
*.exe
*.dmg
__pycache__/

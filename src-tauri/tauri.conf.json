{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalBooks",
  "version": "0.10.0",
  "identifier": "com.localbooks.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalBooks",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "copyright": "Copyright © 2026 turbogizzmo",
    "targets": "all",
    "category": "Finance",
    "shortDescription": "LocalBooks Desktop: local-first double-entry accounting",
    "longDescription": "LocalBooks Desktop keeps a small business's books in a single file on its own computer: invoices, bills, banking, inventory, reconciliation and financial statements, with every transaction posted as a balanced double-entry journal entry.",
    "fileAssociations": [
      {
        "ext": ["localbooks"],
        "name": "LocalBooks Company File",
        "description": "LocalBooks Company File",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-localbooks",
        "exportedType": {
          "identifier": "com.localbooks.company-file",
          "conformsTo": ["public.data", "public.database"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBQzkyOTAzRjVGMERCNjIKUldSaTIvRDFBeW5KV2piREFFVEl5YnV2V0NiNGFZd3RjVTEzeWRoQ0o3MzlGeFNibWNiTDcvdHAK",
      "endpoints": [
        "https://github.com/turbogizzmo/LocalBooks/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
